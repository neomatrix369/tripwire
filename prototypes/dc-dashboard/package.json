{
  "name": "tripwire-dc-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint *.js test/",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --include 'tripwire-live.js' --include 'tripwire-status.js' --include 'tripwire-realtime.js' --include 'tripwire-data.js' --exclude 'support.js' --reporter text --reporter text-summary --check-coverage --lines 95 --functions 85 --branches 80 --statements 95 node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0"
  }
}
