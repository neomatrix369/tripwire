# pizauth tool-local placeholders (optional; prefer parent .env.example).
# Copy values into labs/external-tools-sandbox/.env — never commit secrets.
#
# Providers supported by this lab (upstream pizauth is generic OAuth2):
#   google     — Gmail / Google Cloud OAuth client
#   microsoft  — Entra ID / Office 365
#
# Redirect URI to register (exact, trailing slash):
#   http://localhost:14204/

# PIZAUTH_PROVIDER=microsoft
# PIZAUTH_CLIENT_ID=
# PIZAUTH_CLIENT_SECRET=
# PIZAUTH_ACCOUNT_EMAIL=
# PIZAUTH_ACCOUNT_NAME=lab
# PIZAUTH_REDIRECT_URI=http://localhost:14204/
PIZAUTH_HTTP_LISTEN=0.0.0.0:14204
PIZAUTH_CONFIG_PATH=/config/pizauth.conf
PIZAUTH_IMAGE_TAG=ext-tools-pizauth:lab
