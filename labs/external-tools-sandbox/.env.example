# labs/external-tools-sandbox — placeholder env (NO SECRETS)
# Copy to .env and fill locally. Never commit .env.
#
# Modal auth (same keys as repo-root .env / docs/user-guide/modal-setup.md):
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Prefer interactive `modal setup` when tokens are empty.
# Lab Modal secret name (create via `modal secret create` — do not reuse
# tripwire-supabase / tripwire-scan-secrets):
EXT_TOOLS_MODAL_SECRET=external-tools-sandbox

# --- vibe-kanban ---
VIBE_KANBAN_PORT=3000
# Auth / agent keys if the tool requires them (HITL):
# VIBE_KANBAN_API_KEY=

# --- Who-Targets-Me (browser extension) ---
WTM_BUILD_TARGET=chrome
# Facebook / extension login is HITL — leave empty for build-only smoke:
# WTM_FB_EMAIL=
# WTM_FB_PASSWORD=

# --- pizauth (OAuth daemon) ---
# Host maps :14204 → container; register this redirect URI at the IdP (exact):
#   http://localhost:14204/
PIZAUTH_HOST_PORT=14204
PIZAUTH_HTTP_LISTEN=0.0.0.0:14204
# Default placeholders; oauth-setup.sh switches to /config/pizauth.local.conf
PIZAUTH_CONFIG_PATH=/config/pizauth.conf
PIZAUTH_REDIRECT_URI=http://localhost:14204/
# IdP: google | microsoft  (required for oauth-setup.sh)
# PIZAUTH_PROVIDER=
# OAuth client credentials (HITL — never commit real values):
# PIZAUTH_CLIENT_ID=
# PIZAUTH_CLIENT_SECRET=
# PIZAUTH_ACCOUNT_EMAIL=
# PIZAUTH_ACCOUNT_NAME=lab
# Optional: poll for env vars (seconds) before giving up
# PIZAUTH_OAUTH_WAIT_SECS=0

# --- snare (GitHub webhooks daemon) ---
# Port lock (do not change): Graphiti=:8000, snare lab host=:18000 (maps 18000:8000).
# SNARE_LISTEN is the *container* bind; host publish is SNARE_HOST_PORT only.
SNARE_HOST_PORT=18000
SNARE_LISTEN=0.0.0.0:8000
SNARE_CONFIG_PATH=/config/snare.conf
# Lab smoke uses public fixture secret "secretsecret" baked in config/snare.conf.
# For a real webhook, override via untracked config — do not commit secrets:
# SNARE_GITHUB_SECRET=replace-me-for-signed-ping

# Runtime preference: modal | docker | auto
EXT_TOOLS_RUNTIME=auto
