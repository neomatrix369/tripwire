# Attempt / session logs (local only)
.tries/

# Secrets — keep .env.example tracked (root .gitignore also covers .env)
.env
**/.env
.env.*
!**/.env.example
*.env.local
**/pizauth.local.conf
**/config/pizauth.local.conf

# Four tool siblings: ignore cloned upstream / vendor trees + build junk
# (scaffolding — Dockerfile, README, smoke.sh, configs — stays trackable)
**/vendor/
**/.vendor/
**/node_modules/
**/target/
**/dist/
**/.cache/
**/__pycache__/

# Smoke / build evidence dumps
smoke-logs/
**/.smoke-evidence/
**/smoke-evidence.txt
*.log

# Local MCP / agent noise if dropped under the lab tree
.mcp.json
**/.mcp.json
